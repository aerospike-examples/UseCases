

@startuml

title Realistic RTB canonical model

hide circle

hide empty members

hide Segment
hide Demographics
hide Location
hide Creative
hide Advertiser
hide ActivityEvent
hide Purchase

class UserProfile {
  - String id
  - Date createdAt
  - Date updatedAt
  - Demographics demographics
  - List<String> interests
  - Location location
  - List<ActivityEvent> activity
  - List<Purchase> purchases
  - List<String> lineitemIds
  - List<String> AudienceIds
}

class Demographics {
  +String ageRange
  +String gender
  +String location
  ...etc
}

class Location {
  +String city
  +String state
  +String country
  ...etc
}

class ActivityEvent {
  +String url
  +Date timestamp
  ...etc
}

class Purchase {
  +String itemId
  +Date purchaseDate
  +float amount
  ...etc
}

UserProfile "1" -- "1" Demographics
UserProfile "1" -- "1" Location
UserProfile "1" -- "1..*" ActivityEvent : activity
UserProfile "1" -- "1..*" Purchase : purchases


enum LineitemStatus {
    DRAFT
    ACTIVE
    PAUSED
    FINISHED
}

class Campaign {
    - String id
    - String name
    - List<String> lineitemIds
    - Float budget
    - DateTime startDate
    - DateTime endDate
    - Advertiser advertiser
}


class Lineitem {
    - String id
    - String campaignId
    - Audience audience
    - List<Creative> creatives
    - Float budget
    - DateTime startDate
    - DateTime endDate
    - LineitemStatus status
}

class Audience {
    - String id
    - String name
    - List<Segment> segments
}

class Segment {
  +String id
  +String name
  ...etc
}




class Advertiser {
    - String id
    - String name
    - List<Campaign> campaigns
}


class Creative {
    - String id
    - String name
    - String url
    - String format
    - String size
    - String type
}

Campaign "*" <..> "1..*" Lineitem : lineitems
Advertiser "1" <-> "*" Campaign : campaigns
Advertiser "*" --> "1..*" Creative : creatives
Creative "*" <- "*" Lineitem : creatives
Lineitem "*" <..> "1" Audience : audience
LineitemStatus - Lineitem
Lineitem "1..50" .. "*" UserProfile
Audience "*" -> "1..*" Segment : segments
Audience "*" <.. "1..*" UserProfile



@enduml

@startuml

title RTB realtime model

hide circle

hide empty members

class Profile {
    - String id
    - List<Lineitem> lineitems
    - boolean isFinished

}

enum LineitemStatus {
    DRAFT
    ACTIVE
    PAUSED
    FINISHED
}



class Lineitem {
    - String id
    - String campaignId
    - Audience audience
    - List<Creative> creatives
    - Float budget
    - DateTime startDate
    - DateTime endDate
    - LineitemStatus status
}

class Audience {
    - String id
    - String name
    - List<Segment> segments
}

class Segment {
  +String id
  +String name
  ...etc
}

class Creative {
    - String id
    - String name
    - String url
    - String format
    - String size
    - String type
}

Creative "*" <- "*" Lineitem : creatives
Lineitem "*" -> "1" Audience : audience
LineitemStatus -- Lineitem
Lineitem "1..20" -- "*" Profile

Audience "*" -> "1..*" Segment : segments


@enduml

@startuml

title Audience model

hide circle
hide empty members

class Audience {
    - String id
    - String name
    - List<Segment> segments
}

class Segment {
  +String id
  +String name
  +String description
  +Date creationDate
  +Date lastUpdated
  +Criteria criteria
  +String source
  +Date expiryDate
  +int audienceSize
  +String segmentType
  +List<Lineitems> lineitems
  +PerformanceMetrics performanceMetrics
}

class Criteria {
  +Demographics demographics
  +BehavioralData behavioralData
  +List<String> interests
  ...etc
}

class Demographics {
  +String ageRange
  +String gender
  +String location
  ...etc
}

class BehavioralData {
  +List<String> browsingHistory
  +List<String> purchaseHistory
  ...etc
}

class PerformanceMetrics {
  +float clickThroughRate
  +float conversionRate
  ...etc
}

Audience "*" -> "1..*" Segment : segments

Segment "1" -- "1" Criteria
Criteria "1" -- "1" Demographics
Criteria "1" -- "1" BehavioralData
Segment "1" -- "1" PerformanceMetrics
Segment "*" - "1..*" Lineitems : lineitems
@enduml
